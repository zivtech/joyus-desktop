{
  "name": "joyus-desktop",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm coverage && pnpm test:integration",
    "skill-sync:hook:install": "node scripts/skill-sync/install-hook.mjs",
    "skill-sync:hook:preview": "node scripts/skill-sync/install-hook.mjs --dry-run",
    "skill-sync:tester": "node scripts/skill-sync/run-tester-checklist.mjs",
    "skill-sync:verify-pin": "node scripts/skill-sync/verify-pin-propagation.mjs",
    "mock:control-plane": "tsx scripts/mock-control-plane.mjs",
    "dogfood:smoke": "tsx scripts/dogfood-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "desktop:build": "pnpm --filter @joyus/desktop-companion dev:build",
    "desktop:setup-signing": "bash scripts/setup-signing.sh"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
