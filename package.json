{
  "name": "joyus-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm coverage",
    "skill-sync:hook:install": "node scripts/skill-sync/install-hook.mjs",
    "skill-sync:hook:preview": "node scripts/skill-sync/install-hook.mjs --dry-run",
    "skill-sync:tester": "node scripts/skill-sync/run-tester-checklist.mjs",
    "skill-sync:verify-pin": "node scripts/skill-sync/verify-pin-propagation.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
