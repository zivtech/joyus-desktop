{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Joyus Desktop Companion",
  "version": "0.1.0",
  "identifier": "com.joyus.desktop-companion",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Joyus Desktop Companion",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": []
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": []
    },
    "sql": {},
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
