{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Joyus Desktop",
  "version": "0.1.0",
  "identifier": "com.joyus.desktop-companion",
  "copyright": "© 2024 Joyus Inc.",
  "category": "DeveloperTool",
  "build": {
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["binaries/sidecar-main.mjs"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.joyus.dev/desktop-companion/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "<TAURI_UPDATE_PUBLIC_KEY>"
    }
  }
}
