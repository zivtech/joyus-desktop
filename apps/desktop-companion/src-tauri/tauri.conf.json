{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Joyus Desktop",
  "version": "0.1.0",
  "identifier": "com.joyus.desktop-companion",
  "copyright": "© 2024 Joyus Inc.",
  "category": "DeveloperTool",
  "build": {
    "beforeBuildCommand": "pnpm --filter @joyus/desktop-companion run build:frontend",
    "frontendDist": "../dist-ui"
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["binaries/sidecar-main.mjs"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerScript": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zivtech/joyus-desktop/releases/latest/download/update-manifest.json"
      ],
      "pubkey": "$TAURI_UPDATER_PUBKEY"
    }
  }
}
